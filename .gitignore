# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Ignore files at repo root without extension, except LICENSE
/[!.]*
!/LICENSE
!/*/
!/*.*

# Docs build output
site

# Nested checkouts during package workflow
homebrew-tap
nur-packages

# render.sh tmp files
.release/*/*
!.release/*/*.*
.release/**/*.cache
.release/brew/*.rb
.release/nix/*.nix
!.release/*/template.*
!.release/zcc/*

# Archives
*.tar.gz

# Packaging happens under this directory
tmp

# rubocop-file action
/*.lock

# Nix
.direnv
!flake.lock

# Rust
target
!Cargo.lock

# Release automation
release
